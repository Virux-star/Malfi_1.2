# Copiar como Backend/.env para desarrollo. Nunca subir .env a GitHub.
PORT=3000
NODE_ENV=development
# Producción: https://tu-dominio.cl, sin / al final. En Render se puede omitir
# PUBLIC_URL para utilizar automáticamente RENDER_EXTERNAL_URL.
PUBLIC_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
# Para desarrollo se puede omitir DATABASE_URL y usar los campos DB_*.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=malfi
# true para conexión externa con TLS; false en la red privada del proveedor.
DB_SSL=false
# CA opcional si el proveedor requiere su certificado, con saltos escapados \n.
DB_SSL_CA=
# Generar dos valores distintos: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
ORDER_TOKEN_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Mantener cerrado hasta cargar negocio, productos, tarifas y probar Webpay.
CHECKOUT_ENABLED=false
# disabled | integration (tarjetas de prueba) | production (cobros reales)
WEBPAY_MODE=disabled
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
# Solo staging, con WEBPAY_MODE=integration y correo de prueba.
ALLOW_INTEGRATION_CHECKOUT=false
# disabled | test | production. Para producción verificar el dominio en Resend.
EMAIL_MODE=disabled
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
EMAIL_TEST_TO=
# Mercado Pago Checkout Pro con preferencias. Las credenciales quedan solo aquí.
# disabled | integration | production. Mantén disabled hasta completar la configuración.
MP_MODE=disabled
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# ID numérico de la cuenta VENDEDORA del ambiente seleccionado (no el comprador).
MP_COLLECTOR_ID=
# Origen HTTPS público del backend. Para pruebas locales puede ser un túnel al puerto 3000.
# En producción puede ser el mismo PUBLIC_URL. Sin barra final ni ruta /api.
MP_PUBLIC_BASE_URL=
# Rutas antiguas de laboratorio: no habilitar en producción.
WEBPAY_TEST_MODE=false
WEBPAY_RETRIES_ENABLED=false
MP_TEST_MODE=false
